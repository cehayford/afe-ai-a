# Settings for the free development server. Copy to .env (never commit it) and fill in.
# Every service reads this file; setup steps are in docs/Deployment_Level_AWS.md.

# --- Addresses ---------------------------------------------------------------------------------
# The website and the API (for the mobile apps). Caddy gets HTTPS certificates for both.
# Using Cloudflare Tunnel instead? Put http:// in front of both, e.g. SITE_ADDRESS=http://dev.afe.example,
# and set TUNNEL_TOKEN below.
SITE_ADDRESS=dev.afe.example
API_ADDRESS=api.dev.afe.example
AFE_FRONTEND_URL=https://dev.afe.example
TUNNEL_TOKEN=

# --- Database (PostgreSQL in a container on this server) -----------------------------------
# A long random password: openssl rand -hex 24
POSTGRES_PASSWORD=

# --- App ----------------------------------------------------------------------------------------
# Runs like production (debug off) but with the test providers for ID checks, SMS and payments.
# Only demo and test data on this server: no real Ghana Card or tenant details.
AFE_DEBUG=0
AFE_ALLOW_FAKE_PROVIDERS=1
# openssl rand -hex 32   (two different values)
AFE_SECRET_KEY=
AFE_PII_HASH_KEY=

# --- Files: Cloudflare R2 (S3-compatible) --------------------------------------------------------
# R2 > Manage API tokens > Create token (Object Read & Write on the three buckets).
AFE_STORAGE_BACKEND=s3
AFE_S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
AFE_S3_REGION=auto
AFE_S3_BUCKET_PUBLIC=afe-dev-media-public
AFE_S3_BUCKET_PRIVATE=afe-dev-private
# The public bucket's address: its r2.dev URL, or a custom domain such as https://media.dev.afe.example
AFE_MEDIA_URL=https://pub-<id>.r2.dev
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# R2 doesn't need the newer default checksums boto3 sends.
AWS_REQUEST_CHECKSUM_CALCULATION=when_required
AWS_RESPONSE_CHECKSUM_VALIDATION=when_required

# --- Email ---------------------------------------------------------------------------------------
# Resend (3,000 a month free). The From domain must be verified in Resend.
AFE_EMAIL_PROVIDER=app.modules.notifications.providers.ResendEmail
AFE_EMAIL_FROM=Afe <hello@dev.afe.example>
AFE_RESEND_API_KEY=
# Or any SMTP service, e.g. Brevo (300 a day free):
# AFE_EMAIL_PROVIDER=app.modules.notifications.providers.SmtpEmail
# AFE_SMTP_HOST=smtp-relay.brevo.com
# AFE_SMTP_PORT=587
# AFE_SMTP_SECURITY=starttls
# AFE_SMTP_USERNAME=
# AFE_SMTP_PASSWORD=

# --- Optional: real test accounts ----------------------------------------------------------------
# Paystack test mode (sk_test_...):
# AFE_PAYMENT_PROVIDER=app.modules.billing.providers.Paystack
# AFE_PAYSTACK_SECRET_KEY=
# WhatsApp Cloud API test number (up to 5 test recipients):
# AFE_WHATSAPP_PROVIDER=app.modules.notifications.providers.WhatsAppCloud
# AFE_WHATSAPP_PHONE_NUMBER_ID=
# AFE_WHATSAPP_ACCESS_TOKEN=
# AFE_WHATSAPP_VERIFY_TOKEN=
# AFE_WHATSAPP_APP_SECRET=
# ClamAV (docker compose --profile scan up -d):
# AFE_MALWARE_SCANNER=app.modules.media.scan.ClamAvScanner

# --- Backups to R2 ----------------------------------------------------------------------------------
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BACKUP_BUCKET=afe-dev-backups
BACKUP_HOUR=1
BACKUP_KEEP_DAYS=30
