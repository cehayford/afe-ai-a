# Copy to .env for local use (never commit .env). Production values live in AWS Secrets Manager
# (see infra/terraform/staging/services.tf). With AFE_DEBUG off, the app refuses to start on
# fake providers, local storage or a short secret key.
AFE_DEBUG=1
AFE_SECRET_KEY=change-me-to-at-least-32-random-characters
AFE_FRONTEND_URL=http://localhost:5173

# Leave unset to use SQLite locally (backend/afe.db). Staging/production:
# AFE_DATABASE_URL=postgresql+psycopg://afe:password@host:5432/afe

# Separate secret for hashing Ghana Card numbers. Changing it breaks duplicate detection.
# AFE_PII_HASH_KEY=

# Files: local folders by default; S3 in staging/production.
# AFE_STORAGE_BACKEND=s3
# AFE_S3_REGION=af-south-1
# AFE_S3_BUCKET_PUBLIC=afe-staging-media-public
# AFE_S3_BUCKET_PRIVATE=afe-staging-kyc-private
# AFE_MEDIA_URL=https://<cloudfront-domain>        # where listing photos are served from

# Providers (decisions B4, B5). Fakes are for development only.
# AFE_KYC_PROVIDER=app.modules.identity.providers.<RealProvider>
# AFE_SMS_PROVIDER=app.modules.notifications.providers.<RealProvider>
# AFE_WHATSAPP_PROVIDER=app.modules.notifications.providers.<RealProvider>
# AFE_EMAIL_PROVIDER=app.modules.notifications.providers.<RealProvider>
# AFE_PAYMENT_PROVIDER=app.modules.billing.providers.Paystack
# AFE_PAYSTACK_SECRET_KEY=
# AFE_WHATSAPP_VERIFY_TOKEN=
# AFE_WHATSAPP_APP_SECRET=

# Email on the free development server: ResendEmail (AFE_RESEND_API_KEY) or SmtpEmail
# (AFE_SMTP_HOST, AFE_SMTP_PORT, AFE_SMTP_SECURITY=starttls|ssl|none, AFE_SMTP_USERNAME, AFE_SMTP_PASSWORD).
# AFE_EMAIL_FROM=Afe <hello@dev.afe.example>

# Verification fee per home in pesewas (decision B6). 0 = free for now.
# AFE_VERIFICATION_FEE_PESEWAS=20000
